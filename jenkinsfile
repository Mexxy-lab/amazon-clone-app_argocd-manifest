node {
    // --------------------------------------------------
    // Configuration
    // --------------------------------------------------

    // Docker image repository published by the upstream pipeline.
    env.IMAGE = 'public.ecr.aws/p9c7s9q0/pumejrepo'

    // GitHub manifest repository.
    env.MANIFEST_REPO = 'https://github.com/Mexxy-lab/amazon-clone-app_argocd-manifest.git'

    // --------------------------------------------------
    // Validate upstream pipeline parameter
    // --------------------------------------------------

    stage('Validate Image Tag') {

        // Receive the Docker image tag from the upstream Jenkins job.
        env.DOCKERTAG = params.DOCKERTAG?.trim()

        // Stop the job if the upstream pipeline did not supply a tag.
        if (!env.DOCKERTAG) {
            error 'DOCKERTAG parameter was not supplied!'
        }

        // Validate the expected image tag format.
        if (!(env.DOCKERTAG ==~ /[A-Za-z0-9_.-]+/)) {
            error "Invalid Docker image tag: ${env.DOCKERTAG}"
        }

        echo "Image to deploy: ${env.IMAGE}:${env.DOCKERTAG}"
    }

    // --------------------------------------------------
    // Clone manifest repository
    // --------------------------------------------------

    stage('Clone Repository') {

        // Clone the main branch containing the Kubernetes manifests.
        git branch: 'main',
            url: env.MANIFEST_REPO
    }

    // --------------------------------------------------
    // Update Kubernetes deployment manifest
    // --------------------------------------------------

    stage('Update Deployment Manifest') {

        // Display the current image before making changes.
        sh '''
            echo "Current deployment image:"
            grep -n 'image:' deployment.yml
        '''

        // Replace the existing pumejrepo image reference,
        // regardless of whether it uses private or public ECR.
        sh '''
            sed -i -E \
            "s|(^[[:space:]]*image:[[:space:]]*).*pumejrepo:[^[:space:]]+|\\1${IMAGE}:${DOCKERTAG}|" \
            deployment.yml

            echo "Updated deployment image:"
            grep -n 'image:' deployment.yml
        '''

        // Verify that the new public ECR image and tag exist.
        sh '''
            grep -F "image: ${IMAGE}:${DOCKERTAG}" deployment.yml

            if [ $? -ne 0 ]; then
                echo "ERROR: Deployment image was not updated!"
                exit 1
            fi
        '''

        // Show the changes before committing.
        sh '''
            echo "Manifest changes:"
            git diff -- deployment.yml
        '''
    }

    // --------------------------------------------------
    // Commit and push manifest changes
    // --------------------------------------------------

    stage('Commit and Push Changes') {

        // Configure the Git author for Jenkins-generated commits.
        sh '''
            git config user.email "pumej1985@gmail.com"
            git config user.name "Mexxy-lab"

            # Stage only the deployment manifest.
            git add deployment.yml

            # Display the exact changes before committing.
            git diff --cached
        '''

        // Commit and push using Jenkins-managed Git credentials.
        withCredentials([
            gitUsernamePassword(
                credentialsId: 'pumej-gitpsswd',
                gitToolName: 'Default'
            )
        ]) {

            sh '''
                # Check whether the manifest actually changed.
                if git diff --cached --quiet; then
                    echo "No manifest changes detected. Nothing to commit."
                else
                    # Create a commit containing the new Docker image tag.
                    git commit -m "Update deployment image to ${DOCKERTAG}"

                    # Push the updated manifest to the main branch.
                    git push origin HEAD:main
                fi
            '''
        }
    }

    // --------------------------------------------------
    // Pipeline completion
    // --------------------------------------------------

    stage('Deployment Manifest Updated') {

        echo "Manifest update job completed."
        echo "Docker image: ${env.IMAGE}:${env.DOCKERTAG}"
        echo "ArgoCD can now detect the updated manifest."
    }
}
